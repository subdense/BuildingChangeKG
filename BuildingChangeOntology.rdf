     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="http://www.w3.org/1999/xhtml/vocab#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG">
        <owl:imports rdf:resource="http://purl.org/www.umr-lastig.fr/geodata"/>
        <owl:imports rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/dcat3"/>
        <rdfs:comment xml:lang="en">Concepts related to buiding changes and densification</rdfs:comment>
        <rdfs:label>Knowledge graph of building changes and urban densification</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#member -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#member">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeCollection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeItem"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#BuildingChange -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#BuildingChange">
        <rdfs:comment xml:lang="en">This is some change of one or more buildings -e.g. creation, demolition, change of use-. These can be changes of real world building entities, or changes of building data, or both. One same class is used to represent these different things because distinguishing them would lead to verbose and complexe models. A BuildingChange can be associated with geodata that represent it, this is stored as a property called buildingChangeFeatures which is a query to identify this data.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeCollection -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeCollection">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#Collection"/>
        <rdfs:comment>This is a collection of ChangeItem</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeItem -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#ChangeItem">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#CollectionItem"/>
        <rdfs:comment>A change item is a specific case of building change in reality, that can be of different sizes (e.g. destruction of a building, or development of a residential neighbour over several years), that is observed through data (different data like aerial imagery before and after, change features if they exist, etc.) and described through narratives (acquired on the Web or collected during experts sessions).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#DensificationStudy -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#DensificationStudy">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>A specific activity where actors express and share questions and other actors, possibly the same, try and inform these questions through data.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#UrbanDensification -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/UrbanDensificationKG#UrbanDensification">
        <terms:description>https://github.com/subdense/dashboard/blob/master/Concepts/Concepts.md#urban-densification</terms:description>
        <rdfs:comment>General concept of urban densification, clarified through SUBDENSE dashboard, https://github.com/subdense/dashboard/blob/master/Concepts/Concepts.md#urban-densification</rdfs:comment>
        <rdfs:label>Urban Densification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


