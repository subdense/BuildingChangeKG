     xmlns:adms="http://www.w3.org/ns/adms#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:dcam="http://purl.org/dc/dcam/"
     xmlns:dcat="http://www.w3.org/ns/dcat#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="http://www.w3.org/1999/xhtml/vocab#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange">
        <owl:imports rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/dcat3"/>
        <rdfs:comment xml:lang="en">Concepts related to buiding changes and densification</rdfs:comment>
        <rdfs:label>Ontology of building changes</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#member -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#member">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeCollection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeItem"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeCollection -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeCollection">
        <rdfs:comment>This is a collection of ChangeItem</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeFeature -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeFeature">
        <rdfs:comment xml:lang="en">This is data that describes some change of one or more buildings -e.g. creation, demolition, change of use-. These can be changes of real world building entities, or changes of building data, or both. One same class is used to represent these different things because distinguishing them would lead to verbose and complexe models.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeItem -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#ChangeItem">
        <rdfs:comment>A change item is a specific case of building change in reality, that can be of different sizes (e.g. destruction of a building, or development of a residential neighbour over several years), that is observed through data (different data like aerial imagery before and after, change features if they exist, etc.) and described through narratives (acquired on the Web or collected during experts sessions).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#Concept -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#Concept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>Concept useful for densification discussions which can be more or less ambiguous as well as commonsense or specific to a domain of expertise</rdfs:comment>
        <rdfs:label>Densification concept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#Study -->

    <owl:Class rdf:about="http://www.semanticweb.org/bbucher/ontologies/2025/6/BuildingChange#Study">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>A specific activity where actors express and share questions and other actors, possibly the same, try and inform these questions through data.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


